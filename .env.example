# Copy this file to ".env" and edit. Everything is optional - the app runs with no keys at all
# using the offline "extractive" engine.

# extractive | ollama | groq | gemini | openai | anthropic
LLM_PROVIDER=extractive
# Leave empty to use the provider default. Model names change over time - check the provider's docs.
LLM_MODEL=

# API keys (only the one for your provider is needed). Groq and Gemini have free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama (local, free):  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434

# Retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_CONFIDENCE=0.22

# "auto" = use sentence-transformers if available. "hashing" = force offline fallback.
EMBEDDING_BACKEND=auto
